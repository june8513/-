[Unit]
Description=Material Requisition Auto Upload Monitor
After=network.target material_requisition.service

[Service]
Type=oneshot
User=june
WorkingDirectory=/home/june/-
Environment="PATH=/home/june/-/venv/bin"
# Run the main monitor script
ExecStart=/home/june/-/venv/bin/python /home/june/-/run_all_monitors.py

[Install]
WantedBy=multi-user.target
