# Django 專案環境變數範例檔
# 請複製此檔並命名為 .env，然後填寫適當的值

# 選擇要使用的設定模組 (development / production)
DJANGO_SETTINGS_MODULE=material_requisition_system.settings.development

# Django 密鑰 (正式環境務必修改並保密)
DJANGO_SECRET_KEY=your_secret_key_here

# 外部服務 URL
SHORTAGE_NOTIFICATION_URL=https://httpbin.org/post

# API 金鑰
YOUR_API_KEY_NAME=default_api_key_if_not_set

# 正式環境專用設定 (僅在設定模組為 production 時生效)
# DJANGO_ALLOWED_HOSTS=192.168.6.137,example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.6.137,https://example.com
