[Unit]
Description=Material Requisition System - 領料單系統
After=network.target

[Service]
Type=simple
User=june
WorkingDirectory=/home/june/-
Environment="PATH=/home/june/-/venv/bin"
Environment="PYTHONUNBUFFERED=1"
# Using waitress-serve for production-like serving
ExecStart=/home/june/-/venv/bin/waitress-serve --listen=*:8000 material_requisition_system.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
