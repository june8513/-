[Unit]
Description=Material Requisition Auto Upload Monitor
After=network.target material_requisition.service

[Service]
Type=oneshot
User=june
WorkingDirectory=/home/june/material-requisition
Environment="PATH=/home/june/material-requisition/venv/bin"
# Run the main monitor script
ExecStart=/home/june/material-requisition/venv/bin/python /home/june/material-requisition/scripts/run_all_monitors.py

[Install]
WantedBy=multi-user.target
